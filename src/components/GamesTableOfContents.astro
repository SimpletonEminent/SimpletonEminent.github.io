---
// 覆盖 Starlight 的桌面端 TableOfContents:
// - /games 路由 → 渲染游戏列表(替代 "On this page"),与卡片画廊双向联动
// - /blog 路由 → 渲染文章总览的年份归档 TOC
// - 其他路由 → 渲染原生 TOC
// 统一消费 toc-resolver 深层解析接缝与 TableOfContentsView 通用展示模块 (Spec 24)
import { getCollection } from 'astro:content';
import DefaultTableOfContents from '@astrojs/starlight/components/TableOfContents.astro';
import { resolveTocContext } from '../lib/toc-resolver';
import TableOfContentsView from './TableOfContentsView.astro';

const tocContext = await resolveTocContext(Astro.url.pathname, {
  getDocs: () => getCollection('docs'),
});
---

{
  tocContext.mode === 'games' ? (
    <nav class="games-toc" aria-label="游戏列表" data-games-toc>
      <h2>🎮 游戏列表</h2>
      <div class="games-toc-list">
        <TableOfContentsView context={tocContext} />
      </div>
    </nav>
  ) : tocContext.mode === 'blog-overview' ? (
    <nav class="blog-overview-toc" aria-label="年份归档">
      <h2>📅 年份归档</h2>
      <ul class="overview-toc-list">
        <TableOfContentsView context={tocContext} />
      </ul>
    </nav>
  ) : (
    <DefaultTableOfContents />
  )
}

<style>
	@layer starlight.core {
		/* --- 文章总览年份归档 TOC --- */
		.blog-overview-toc h2 {
			margin: 0 0 0.75rem;
			color: var(--sl-color-white);
			font-size: var(--sl-text-h5);
			font-weight: 600;
			line-height: var(--sl-line-height-headings);
		}

		.overview-toc-list {
			list-style: none;
			padding: 0;
			margin: 0;
			display: flex;
			flex-direction: column;
			gap: 0.35rem;
		}

		/* 视觉继承 Starlight 原生 TOC 质感:小字号、柔和灰、sticky 由 right-sidebar 容器提供 */
		.games-toc h2 {
			margin: 0 0 0.75rem;
			color: var(--sl-color-white);
			font-size: var(--sl-text-h5);
			font-weight: 600;
			line-height: var(--sl-line-height-headings);
		}

		.games-toc-list {
			/* 固定高度 + 独立滚动:列表在可视区域内自己滚,不撑长整页 */
			display: flex;
			flex-direction: column;
			gap: 0.125rem;
			max-height: calc(100vh - 12rem);
			overflow-y: auto;
			padding-right: 0.25rem;
			/* 细滚动条 + 明暗适配 */
			scrollbar-width: thin;
			scrollbar-color: var(--sl-color-gray-5) transparent;
		}

		.games-toc-list::-webkit-scrollbar {
			width: 6px;
		}

		.games-toc-list::-webkit-scrollbar-track {
			background: transparent;
		}

		.games-toc-list::-webkit-scrollbar-thumb {
			background: var(--sl-color-gray-5);
			border-radius: 999px;
		}

		.games-toc-list::-webkit-scrollbar-thumb:hover {
			background: var(--sl-color-gray-4);
		}
	}
</style>
