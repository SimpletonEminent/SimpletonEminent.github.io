---
// 覆盖 Starlight 的桌面端 TableOfContents:
// - /games 路由 → 渲染游戏列表(替代 "On this page"),与卡片画廊双向联动
// - 其他路由 → 渲染原生 TOC
import DefaultTableOfContents from '@astrojs/starlight/components/TableOfContents.astro';
import { loadMergedGames, formatHours, statusText } from '../lib/steam-data';

const isGamesRoute = Astro.url.pathname === '/games' || Astro.url.pathname.startsWith('/games/');
const { games } = isGamesRoute ? loadMergedGames() : { games: [] };
---

{
  isGamesRoute ? (
    <nav class="games-toc" aria-label="游戏列表" data-games-toc>
      <h2>🎮 游戏列表</h2>
      <div class="games-toc-list">
        {
          games.map((game) => (
            <button type="button" class="games-toc-row" data-appid={game.appid}>
              <span class="games-toc-name">{game.name}</span>
              <span class="status-badge" data-status={game.my_status}>
                {statusText(game.my_status)}
              </span>
              <span class="games-toc-playtime">{formatHours(game.playtime_hours)}h</span>
            </button>
          ))
        }
        {games.length === 0 && <p class="games-toc-empty">暂无游戏数据</p>}
      </div>
    </nav>
  ) : (
    <DefaultTableOfContents />
  )
}

<style>
	@layer starlight.core {
		/* 视觉继承 Starlight 原生 TOC 质感:小字号、柔和灰、sticky 由 right-sidebar 容器提供 */
		.games-toc h2 {
			margin: 0 0 0.75rem;
			color: var(--sl-color-white);
			font-size: var(--sl-text-h5);
			font-weight: 600;
			line-height: var(--sl-line-height-headings);
		}

		.games-toc-list {
			display: flex;
			flex-direction: column;
			gap: 0.125rem;
		}

		.games-toc-row {
			display: flex;
			align-items: center;
			gap: 0.375rem;
			width: 100%;
			padding: 0.3rem 0.5rem;
			border: none;
			border-radius: 0.375rem;
			background: transparent;
			color: var(--sl-color-gray-3);
			font-size: var(--sl-text-xs);
			text-align: left;
			cursor: pointer;
			font-family: inherit;
			line-height: 1.5;
		}

		.games-toc-row:hover {
			color: var(--sl-color-white);
			background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
		}

		.games-toc-row.active {
			color: var(--sl-color-white);
			background: color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
			box-shadow: inset 2px 0 0 var(--sl-color-accent);
		}

		.games-toc-name {
			flex: 1;
			min-width: 0;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.games-toc-playtime {
			flex-shrink: 0;
			color: var(--sl-color-gray-3);
			font-size: var(--sl-text-2xs);
		}

		.games-toc-empty {
			margin: 0;
			color: var(--sl-color-gray-3);
			font-size: var(--sl-text-xs);
		}

		/* 状态徽章:三态胶囊,明暗双套(与画廊卡片一致) */
		.games-toc :global(.status-badge) {
			display: inline-block;
			flex-shrink: 0;
			border-radius: 999px;
			padding: 0.05em 0.5em;
			font-size: var(--sl-text-2xs);
			line-height: 1.6;
			white-space: nowrap;
		}

		.games-toc :global(.status-badge[data-status='uncompleted']) {
			background: #374151;
			color: #e5e7eb;
		}

		.games-toc :global(.status-badge[data-status='completed']) {
			background: #1e3a5f;
			color: #93c5fd;
		}

		.games-toc :global(.status-badge[data-status='perfect']) {
			background: #78350f;
			color: #fcd34d;
		}

		:root[data-theme='light'] .games-toc :global(.status-badge[data-status='uncompleted']) {
			background: #e5e7eb;
			color: #374151;
		}

		:root[data-theme='light'] .games-toc :global(.status-badge[data-status='completed']) {
			background: #dbeafe;
			color: #1d4ed8;
		}

		:root[data-theme='light'] .games-toc :global(.status-badge[data-status='perfect']) {
			background: #fef3c7;
			color: #92400e;
		}
	}
</style>

<script>
	// 联动协议:
	// - 点击本列表行 → 派发 `steam:select`(detail: { appid }),画廊组件监听后滚动定位 + 展开气泡
	// - 画廊组件选中卡片 → 派发 `steam:highlight`(detail: { appid }),本组件据此高亮对应行
	// - 画廊组件收起 → 派发 `steam:highlight`(detail: { appid: null }),清除高亮
	const toc = document.querySelector('[data-games-toc]');
	if (toc) {
		const rows = Array.from(toc.querySelectorAll('.games-toc-row')).filter(
			(el): el is HTMLElement => el instanceof HTMLElement
		);
		const rowByAppid = new Map();
		for (const row of rows) {
			rowByAppid.set(Number(row.dataset.appid), row);
		}

		toc.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof HTMLElement)) return;
			const row = target.closest('.games-toc-row');
			if (!(row instanceof HTMLElement)) return;
			window.dispatchEvent(
				new CustomEvent('steam:select', { detail: { appid: Number(row.dataset.appid) } })
			);
		});

		window.addEventListener('steam:highlight', (event) => {
			const appid = (event as CustomEvent).detail?.appid ?? null;
			for (const [id, row] of rowByAppid) {
				row.classList.toggle('active', id === appid);
			}
		});
	}
</script>
