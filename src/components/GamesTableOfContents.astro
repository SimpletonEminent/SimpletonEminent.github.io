---
// 覆盖 Starlight 的桌面端 TableOfContents:
// - /games 路由 → 渲染游戏列表(替代 "On this page"),与卡片画廊双向联动
// - 其他路由 → 渲染原生 TOC
import DefaultTableOfContents from '@astrojs/starlight/components/TableOfContents.astro';
import { loadMergedGames, formatHours, statusText, sortGames, badgesFor } from '../lib/steam-data';

const isGamesRoute = Astro.url.pathname === '/games' || Astro.url.pathname.startsWith('/games/');
const { games } = isGamesRoute ? loadMergedGames() : { games: [] };

// 排序预设:与画廊组件同一实现预计算,客户端 script 无法 import 模块(define:vars 只序列化 JSON)
// 因此这里用真实数据 sortGames 跑出 4 种排序后的 appid 顺序,注入客户端供 steam:sort 重排
const sortPresets = isGamesRoute
  ? {
      playtime: sortGames(games, 'playtime', 'desc').map((g) => g.appid),
      recent: sortGames(games, 'recent', 'desc').map((g) => g.appid),
      status: sortGames(games, 'status', 'desc').map((g) => g.appid),
      release: sortGames(games, 'release', 'desc').map((g) => g.appid),
      nameAsc: sortGames(games, 'nameAsc', 'asc').map((g) => g.appid),
      nameDesc: sortGames(games, 'nameDesc', 'desc').map((g) => g.appid),
    }
  : { playtime: [], recent: [], status: [], release: [], nameAsc: [], nameDesc: [] };
---

{
  isGamesRoute ? (
    <nav class="games-toc" aria-label="游戏列表" data-games-toc>
      <h2>🎮 游戏列表</h2>
      <div class="games-toc-list">
        {
          games.map((game) => (
            <button type="button" class="games-toc-row" data-appid={game.appid}>
              <span class="games-toc-name" title={game.name}>{game.name_zh || game.name}</span>
              {badgesFor(game).map((badge) =>
                badge.kind === 'status' ? (
                  <span class="status-badge" data-status={badge.value}>
                    {statusText(badge.value)}
                  </span>
                ) : (
                  <span class="status-badge rank-badge">{badge.value}</span>
                )
              )}
              <span class="games-toc-playtime">{formatHours(game.playtime_hours)}h</span>
            </button>
          ))
        }
        {games.length === 0 && <p class="games-toc-empty">暂无游戏数据</p>}
      </div>
    </nav>
  ) : (
    <DefaultTableOfContents />
  )
}

<style>
	@layer starlight.core {
		/* 视觉继承 Starlight 原生 TOC 质感:小字号、柔和灰、sticky 由 right-sidebar 容器提供 */
		.games-toc h2 {
			margin: 0 0 0.75rem;
			color: var(--sl-color-white);
			font-size: var(--sl-text-h5);
			font-weight: 600;
			line-height: var(--sl-line-height-headings);
		}

		.games-toc-list {
			/* 固定高度 + 独立滚动:列表在可视区域内自己滚,不撑长整页 */
			display: flex;
			flex-direction: column;
			gap: 0.125rem;
			max-height: calc(100vh - 12rem);
			overflow-y: auto;
			padding-right: 0.25rem;
			/* 细滚动条 + 明暗适配 */
			scrollbar-width: thin;
			scrollbar-color: var(--sl-color-gray-5) transparent;
		}

		.games-toc-list::-webkit-scrollbar {
			width: 6px;
		}

		.games-toc-list::-webkit-scrollbar-track {
			background: transparent;
		}

		.games-toc-list::-webkit-scrollbar-thumb {
			background: var(--sl-color-gray-5);
			border-radius: 999px;
		}

		.games-toc-list::-webkit-scrollbar-thumb:hover {
			background: var(--sl-color-gray-4);
		}

		.games-toc-row {
			display: flex;
			align-items: center;
			gap: 0.375rem;
			width: 100%;
			padding: 0.3rem 0.5rem;
			border: none;
			border-radius: 0.375rem;
			background: transparent;
			color: var(--sl-color-gray-3);
			font-size: var(--sl-text-xs);
			text-align: left;
			cursor: pointer;
			font-family: inherit;
			line-height: 1.5;
		}

		.games-toc-row:hover {
			color: var(--sl-color-white);
			background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
		}

		.games-toc-row.active {
			color: var(--sl-color-white);
			background: color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
			box-shadow: inset 2px 0 0 var(--sl-color-accent);
		}

		.games-toc-name {
			flex: 1;
			min-width: 0;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.games-toc-playtime {
			flex-shrink: 0;
			color: var(--sl-color-gray-3);
			font-size: var(--sl-text-2xs);
		}

		.games-toc-empty {
			margin: 0;
			color: var(--sl-color-gray-3);
			font-size: var(--sl-text-xs);
		}

		/* 状态徽章:三态胶囊,明暗双套(与画廊卡片一致) */
		.games-toc :global(.status-badge) {
			display: inline-block;
			flex-shrink: 0;
			border-radius: 999px;
			padding: 0.05em 0.5em;
			font-size: var(--sl-text-2xs);
			line-height: 1.6;
			white-space: nowrap;
		}

		.games-toc :global(.status-badge[data-status='uncompleted']) {
			background: #374151;
			color: #e5e7eb;
		}

		.games-toc :global(.status-badge[data-status='completed']) {
			background: #1e3a5f;
			color: #93c5fd;
		}

		.games-toc :global(.status-badge[data-status='perfect']) {
			background: #78350f;
			color: #fcd34d;
		}

		.games-toc :global(.status-badge[data-status='ongoing']) {
			background: #4c1d95;
			color: #e9d5ff;
		}

		.games-toc :global(.status-badge[data-status='hiatus']) {
			background: #365314;
			color: #d9f99d;
		}

		.games-toc :global(.status-badge[data-status='retired']) {
			background: #1f2937;
			color: #9ca3af;
		}

		:root[data-theme='light'] .games-toc :global(.status-badge[data-status='uncompleted']) {
			background: #e5e7eb;
			color: #374151;
		}

		:root[data-theme='light'] .games-toc :global(.status-badge[data-status='completed']) {
			background: #dbeafe;
			color: #1d4ed8;
		}

		:root[data-theme='light'] .games-toc :global(.status-badge[data-status='perfect']) {
			background: #fef3c7;
			color: #92400e;
		}

		:root[data-theme='light'] .games-toc :global(.status-badge[data-status='ongoing']) {
			background: #f3e8ff;
			color: #6b21a8;
		}

		:root[data-theme='light'] .games-toc :global(.status-badge[data-status='hiatus']) {
			background: #f7fee7;
			color: #4d7c0f;
		}

		:root[data-theme='light'] .games-toc :global(.status-badge[data-status='retired']) {
			background: #f3f4f6;
			color: #6b7280;
		}

		.games-toc :global(.status-badge.rank-badge) {
			background: rgba(6, 78, 59, 0.4);
			color: #6ee7b7;
			border: 1px solid rgba(6, 95, 70, 0.5);
		}

		:root[data-theme='light'] .games-toc :global(.status-badge.rank-badge) {
			background: #ecfdf5;
			color: #047857;
			border: 1px solid #a7f3d0;
		}
	}
</style>

<script is:inline define:vars={{ sortPresets }}>
	// 联动协议:
	// - 点击本列表行 → 派发 `steam:select`(detail: { appid }),画廊组件监听后滚动定位 + 展开气泡
	// - 画廊组件选中卡片 → 派发 `steam:highlight`(detail: { appid }),本组件据此高亮对应行
	// - 画廊组件收起 → 派发 `steam:highlight`(detail: { appid: null }),清除高亮
	// - 画廊组件切换排序 → 派发 `steam:sort`(detail: { key, dir }),本组件按 sortPresets 重排
	const toc = document.querySelector('[data-games-toc]');
	if (toc) {
		const rows = Array.from(toc.querySelectorAll('.games-toc-row')).filter(
			(el) => el instanceof HTMLElement
		);
		const rowByAppid = new Map();
		for (const row of rows) {
			rowByAppid.set(Number(row.dataset.appid), row);
		}
		const list = toc.querySelector('.games-toc-list');

		toc.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof HTMLElement)) return;
			const row = target.closest('.games-toc-row');
			if (!(row instanceof HTMLElement)) return;
			window.dispatchEvent(
				new CustomEvent('steam:select', { detail: { appid: Number(row.dataset.appid) } })
			);
		});

		window.addEventListener('steam:highlight', (event) => {
			const appid = event.detail?.appid ?? null;
			for (const [id, row] of rowByAppid) {
				row.classList.toggle('active', id === appid);
			}
		});

		// 排序同步:画廊切换排序时,按预计算的 sortPresets 重排本列表的 DOM 行
		window.addEventListener('steam:sort', (event) => {
			const detail = event.detail ?? {};
			const key = detail.key ?? 'playtime';
			const order = sortPresets[key] ?? sortPresets.playtime;
			if (!list || !Array.isArray(order)) return;
			for (const appid of order) {
				const row = rowByAppid.get(appid);
				if (row) list.appendChild(row);
			}
		});
	}
</script>
