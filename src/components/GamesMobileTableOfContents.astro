---
// 覆盖 Starlight 的移动端 TableOfContents:
// - /games 路由 → 渲染折叠的游戏列表(替代 "On this page" 下拉),与卡片画廊联动
// - /blog 路由 → 渲染折叠的文章总览年份列表
// - 其他路由 → 渲染原生移动端 TOC
// 统一消费 toc-resolver 深层解析接缝与 TableOfContentsView 通用展示模块 (Spec 24)
import { getCollection } from 'astro:content';
import DefaultMobileTableOfContents from '@astrojs/starlight/components/MobileTableOfContents.astro';
import { resolveTocContext } from '../lib/toc-resolver';
import TableOfContentsView from './TableOfContentsView.astro';

const tocContext = await resolveTocContext(Astro.url.pathname, {
  getDocs: () => getCollection('docs'),
});
---

{
  tocContext.mode === 'games' ? (
    <nav class="games-mobile-toc" aria-label="游戏列表" data-games-mobile-toc>
      <details>
        <summary>
          <span class="toggle">🎮 游戏列表</span>
        </summary>
        <div class="dropdown">
          <TableOfContentsView context={tocContext} isMobile />
        </div>
      </details>
    </nav>
  ) : tocContext.mode === 'blog-overview' ? (
    <nav class="games-mobile-toc" aria-label="年份归档">
      <details>
        <summary>
          <span class="toggle">📅 年份归档</span>
        </summary>
        <div class="dropdown">
          <TableOfContentsView context={tocContext} isMobile />
        </div>
      </details>
    </nav>
  ) : (
    <DefaultMobileTableOfContents />
  )
}

<style>
	@layer starlight.core {
		nav {
			position: fixed;
			z-index: var(--sl-z-index-toc);
			top: calc(var(--sl-nav-height) - 1px);
			inset-inline: 0;
			border-top: 1px solid var(--sl-color-gray-5);
			background-color: var(--sl-color-bg-nav);
		}
		@media (min-width: 50rem) {
			nav {
				inset-inline-start: var(--sl-content-inline-start, 0);
			}
		}

		summary {
			gap: 0.5rem;
			align-items: center;
			height: var(--sl-mobile-toc-height);
			border-bottom: 1px solid var(--sl-color-hairline-shade);
			padding: 0.5rem 1rem;
			font-size: var(--sl-text-xs);
			outline-offset: var(--sl-outline-offset-inside);
			cursor: pointer;
		}
		summary::marker,
		summary::-webkit-details-marker {
			display: none;
		}

		.toggle {
			display: inline-flex;
			align-items: center;
			gap: 0.375rem;
			color: var(--sl-color-white);
			user-select: none;
		}

		.dropdown {
			--border-top: 1px;
			margin-top: calc(-1 * var(--border-top));
			border: var(--border-top) solid var(--sl-color-gray-6);
			border-top-color: var(--sl-color-hairline-shade);
			max-height: calc(85vh - var(--sl-nav-height) - var(--sl-mobile-toc-height));
			overflow-y: auto;
			background-color: var(--sl-color-black);
			box-shadow: var(--sl-shadow-md);
			overscroll-behavior: contain;
			padding: 0.5rem;
		}
	}
</style>
