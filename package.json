{
  "name": "my-blog",
  "type": "module",
  "version": "0.1.0",
  "description": "个人博客 - 基于 Astro + Starlight",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "json-to-csv": "node scripts/json-to-csv.mjs",
    "csv-to-json": "node scripts/csv-to-json.mjs",
    "fill-play-year": "node scripts/fill-play-year.mjs",
    "review": "node scripts/add-review.mjs",
    "test": "node --experimental-strip-types scripts/test-badges.ts && node scripts/test-play-year.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/starlight": "^0.41.6",
    "astro": "^7.1.6",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "remark-breaks": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "sharp": "^0.35.0",
    "typescript": "^6.0.3"
  }
}
